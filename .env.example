# Copy this file to `.env` and adjust the values for your machine.

# HTTP port used by the web UI.
WEB_PORT=8080

# WebSocket relay base URL (per-peer rooms are appended as /<peer-id>).
# Example: wss://ws.tridentlab.in
WS_RELAY=

# libp2p relay multiaddr, including the relay's peer ID.
# Example: /ip4/203.0.113.10/tcp/4001/p2p/12D3KooW...
# Leave empty to run without a relay; internet connectivity through NAT
# requires one.
LIBP2P_RELAY=
